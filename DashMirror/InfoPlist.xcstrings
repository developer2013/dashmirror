{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only for the experimental “Touch in the car”: DashMirror talks to this iPhone’s own developer services through LocalDevVPN to pass taps from the car screen on to the iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für das Experiment „Touch im Auto“: DashMirror spricht über LocalDevVPN mit den Entwicklerdiensten dieses iPhones, um Tipps vom Autodisplay ans iPhone weiterzugeben."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only to tell whether the car is moving – then the picture in the car is hidden. Nothing is stored or sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur um zu erkennen, ob das Auto fährt: Dann wird das Bild im Auto ausgeblendet. Nichts wird gespeichert oder gesendet."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detects car trips even without GPS (e.g. in a tunnel), so the picture in the car stays off while driving."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt Autofahrten auch ohne GPS (z. B. im Tunnel), damit das Bild im Auto während der Fahrt aus bleibt."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves instant-replay clips of your game to Photos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert Sofort-Wiederholungen deines Spiels in Fotos."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
