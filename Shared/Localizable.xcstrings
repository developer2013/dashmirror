    "Takes effect after restarting the app: close it in the app switcher and open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach einem Neustart der App übernommen: im App-Umschalter schließen und neu öffnen."
