    "The clip could not be saved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Clip konnte nicht gespeichert werden"
          }
        }
      }
    },
    "The picture comes back as soon as the car stands still." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild erscheint wieder, sobald das Auto steht."
          }
        }
      }
    },
    "Then switch to your game. You control it with a Bluetooth controller on the iPhone; sound plays through the car as usual." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach zum Spiel wechseln. Gesteuert wird per Bluetooth-Controller am iPhone, der Ton läuft wie gewohnt über das Auto."
          }
        }
      }
    },
    "Up to 10 % stretch and 10 % zoom combined – usually fills wide displays with barely visible changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 10 % strecken und 10 % zoomen kombiniert – füllt breite Displays meist mit kaum sichtbaren Änderungen."
          }
        }
      }
    },
    "Waiting for Photos" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf Fotos"
          }
        }
