    },
    "Waiting for the broadcast" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf die Übertragung"
          }
        }
      }
    },
    "When the car moves, the picture in the car disappears immediately. Without location access it stays off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fährt das Auto, wird das Bild im Auto sofort ausgeblendet. Ohne Standort bleibt es aus."
          }
        }
      }
    },
    "Whole picture, black bars." : {
