    "Fills completely, edges are cut off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt ganz, die Ränder werden abgeschnitten."
          }
        }
      }
    },
    "Fills completely, the picture gets distorted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt ganz, das Bild wird verzerrt."
          }
        }
      }
    },
    "Fills when the shapes are close (under 15 %), otherwise fits. Never distorts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt randlos, wenn die Formen ähnlich sind (unter 15 %), sonst eingepasst. Verzerrt nie."
          }
        }
      }
    },
    "Fit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einpassen"
          }
        }
      }
    },
    "Follows the iPhone language unless you pick one here. Changes apply immediately, in the car as well." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt der iPhone-Sprache, außer du wählst hier eine aus. Gilt sofort, auch im Auto."
          }
        }
      }
    },
