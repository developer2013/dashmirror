    "Dimming" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abdunkeln"
          }
        }
      }
    },
    "Dims the picture in the car at night so bright games don’t dazzle. “Automatic” follows the car’s day/night switch (headlights or light sensor). If the car always reports night, choose “Always” or “Off”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkelt das Bild im Auto nachts ab, damit helle Spiele nicht blenden. „Automatisch“ folgt der Tag/Nacht-Umschaltung des Autos (Licht oder Lichtsensor). Meldet das Auto immer Nacht, wähle „Immer“ oder „Aus“."
          }
        }
      }
    },
    "Driving lock" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahrsperre"
          }
