<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Default device build WITHOUT CarPlay. Mirroring pipeline, test pattern and phone UI work; the car screen
  does not appear. Once Apple granted carplay-video AND carplay-audio for your App ID, set
  DASHMIRROR_ENTITLEMENTS = Config/DashMirror-CarPlay.entitlements in Config/Local.xcconfig.
-->
<plist version="1.0">
<dict>
	<!-- Shared container: Unix socket to the broadcast extension, settings, logs -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DASHMIRROR_APP_GROUP)</string>
	</array>
</dict>
</plist>
