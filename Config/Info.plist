<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App-Gruppe aus Config/Signing.xcconfig bzw. Local.xcconfig – der Code liest sie hier (Mirror.appGroup) -->
	<key>DashMirrorAppGroup</key>
	<string>$(DASHMIRROR_APP_GROUP)</string>
	<!-- Fahrsperre: nur Geschwindigkeit/Bewegung, nichts wird gespeichert oder gesendet -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Only to tell whether the car is moving – then the picture in the car is hidden. Nothing is stored or sent.</string>
	<!-- Sofort-Wiederholung: Clips nur hinzufuegen, nichts lesen -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Saves instant-replay clips of your game to Photos.</string>
	<!-- Documents in der Dateien-App: Clips ohne Fotos-Zugriff (Clips/) und die Protokolle (Logs/) -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSMotionUsageDescription</key>
	<string>Detects car trips even without GPS (e.g. in a tunnel), so the picture in the car stays off while driving.</string>
	<!-- Im Auto ist das Spiel am iPhone vorn und unsere iPhone-Oberflaeche im Hintergrund. Damit die Fahrsperre
	     trotzdem Geschwindigkeiten bekommt, darf der Standort im Hintergrund weiterlaufen (blauer Hinweis). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- Szenen: iPhone-Fenster (SwiftUI, automatisch) und das Autodisplay als normales UIKit-Fenster.
	     iOS legt die CarPlay-Szene nur an, wenn die App mit carplay-video UND carplay-audio signiert ist
	     (Vorbild: github.com/rPlayAI/cafari-lite, MIT). Die Rolle hat in Swift keinen Namen,
	     siehe CarPlaySceneDelegate.swift. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleCarPlay</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
